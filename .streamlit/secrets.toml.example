# Supabase PostgreSQL Connection configuration for Streamlit
# Copy this file to .streamlit/secrets.toml and replace with your Supabase credentials

# Option 1: Direct Supabase PostgreSQL Connection String (Recommended)
# Find this in Supabase: Project Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL = "postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Option 2: Individual Connection Parameters
# [postgres]
# host = "aws-0-[YOUR-REGION].pooler.supabase.com"
# port = 6543
# dbname = "postgres"
# user = "postgres.[YOUR-PROJECT-REF]"
# password = "YOUR_DATABASE_PASSWORD"
