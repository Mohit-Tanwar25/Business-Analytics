# Supabase / PostgreSQL Environment Configuration
# Copy this file to .env and fill in your Supabase connection details

# Direct Connection String (from Supabase Dashboard -> Project Settings -> Database -> URI)
SUPABASE_DB_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Or Individual Variables:
# SUPABASE_DB_HOST=aws-0-[YOUR-REGION].pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.[YOUR-PROJECT-REF]
# SUPABASE_DB_PASSWORD=YOUR_PASSWORD
